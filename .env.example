# Server
NODE_ENV=development
PORT=3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/fitness-mgt?retryWrites=true&w=majority

# Auth (Dev1)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# AI Gateway (Dev2) — OpenAI-compatible hosted open models (Groq default)
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_MS=30000
