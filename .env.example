# Server
NODE_ENV=development
PORT=4000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/fitness-mgt?retryWrites=true&w=majority

# Auth (Dev1)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# AI Gateway (Dev2) — Gemini with model shifting on 429 / 404 / 503
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_TIMEOUT_MS=30000

# Screenshot storage (Day 2 uploads) — Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram bot (Dev 2) — reminder delivery; sendTelegram stub until wired
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Hosting note: API must be always-on (not serverless cold-only) so the
# Day 2 reminder job can run on a schedule (e.g. Railway / Render / VPS).
