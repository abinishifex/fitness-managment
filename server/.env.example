# Server
NODE_ENV=development
PORT=4000

# MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/fitness-mgt

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — comma-separated frontend origins (required in production)
FRONTEND_ORIGIN=http://localhost:3000

# AI Gateway — Gemini with model shifting on 429 / 404 / 503
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.6-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_TIMEOUT_MS=30000

# Cloudinary — screenshot upload (Day 2). Create at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram Bot (Day 2) — create via @BotFather; set webhook to
# POST https://YOUR_API/api/telegram/webhook with secret header
TELEGRAM_BOT_TOKEN=
# Without @ — shown on Link Telegram screen / deep links
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Reminder job — Railway cron can POST /api/internal/reminders/run
# with header X-Reminder-Secret. Falls back to TELEGRAM_WEBHOOK_SECRET.
REMINDER_JOB_SECRET=
ENABLE_REMINDER_CRON=true

# Sentry (optional)
SENTRY_DSN=

# Bootstrap admin (scripts/bootstrapAdmin.js)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PHONE=

# Hosting: API must be always-on (Railway / Render / VPS) so the daily
# reminder cron can run. Frontend can stay on Vercel.
